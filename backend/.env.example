DATABASE_URL=postgresql+psycopg://replace_user:replace_password@localhost:5432/replace_database
# JSON mapping of stable PM identities to unique, randomly generated bearer tokens (32+ chars).
# Supply tokens interactively to API clients; never put them in VITE_* variables.
AUTH_TOKENS={}
LEGACY_TOKEN_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173
SESSION_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]
WORKER_POLL_SECONDS=1
# BA uses owner-scoped keys/models saved through AI Settings. Other steps remain simulated.
# Restart API AND worker after changing these limits.
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=4096
DEV_MAX_OUTPUT_TOKENS=16384
# Generate once with scripts/setup_local.py; keep the same value on API and worker.
CONNECTION_ENCRYPTION_KEY=
